# Grafana Cloud Loki & OpenTelemetry Configuration

# Loki API Endpoint
LOKI_URL=https://logs-prod-035.grafana.net

# Grafana Cloud Loki User ID (Instance ID)
LOKI_USER=1280388

# OpenTelemetry OTLP Exporter Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-gb-south-0.grafana.net/otlp

# OpenTelemetry / Loki Auth Header (Basic <base64(USER:TOKEN)> or Authorization=...)
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <YOUR_BASE64_TOKEN>
